{
  "name": "zhumeng-launcher",
  "version": "0.0.1-preview.1",
  "private": true,
  "description": "筑梦启动器",
  "author": "杯艺宣",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/licenses.mjs && tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "verify": "npm run typecheck && npm test && npm run build && playwright test tests/ui.spec.ts && playwright test --config tests/usability.config.ts",
    "smoke:network": "npm run build && node scripts/smoke-network.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:shell": "npm run build && electron scripts/smoke-shell.cjs",
    "test:ui": "npm run build && playwright test tests/ui.spec.ts && playwright test --config tests/usability.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/yazl": "^3.3.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2",
    "pngjs": "^7.0.0",
    "undici": "7.30.1",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "@xmcl/installer": {
      "undici": "$undici"
    },
    "@xmcl/file-transfer": {
      "undici": "$undici"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beizilaoshi/Buildingdreams.git"
  },
  "homepage": "https://github.com/beizilaoshi/Buildingdreams",
  "bugs": {
    "url": "https://github.com/beizilaoshi/Buildingdreams/issues"
  }
}
